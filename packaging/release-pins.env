# Build-time pins for the Linux release artifacts, in ONE place because two forges now read them.
#
# arm64 is built natively on GitHub and amd64 natively on Forgejo (nothing is emulated), so these
# values are consumed by two workflows on two hosts. Inline copies would drift the first time one
# was bumped and the other was not, and the failure would surface as an architecture-dependent
# release rather than as a diff.
#
# Sourced, not executed. Renovate reads the annotations here — see the managerFilePatterns entry
# in .renovaterc.json.

# Safe to track upstream only because nothing is emulated. A onefile app built since 6.22.1 refuses
# to start when its parent process is a different executable, which is true of every binary run
# under an emulator and false of one built on its own architecture. If an arm64 build ever moves
# back onto an amd64 host, this needs a hold again.
# renovate: datasource=pypi depName=pyinstaller
PYINSTALLER="6.22.2"

# Built from source with --enable-shared inside the manylinux image: manylinux's own interpreters
# are static (Py_ENABLE_SHARED=0) and PyInstaller cannot freeze against them. Kept on the same
# version the sister repos bundle. The sha256 is python.org's own for this exact tarball and is
# checked before the build; bumping the version means bumping it.
# The CPython TAG dep, not the setup-python one. This interpreter is frozen into shipped
# artifacts, so it must move with the checksum below that a human reviews alongside it —
# never on the schedule of the actions/python-versions manifest. Same identity as the
# macOS half and as the sibling project, so one bump moves all of them together.
# renovate: datasource=github-tags depName=python/cpython versioning=pep440
PYTHON_VERSION="3.14.7"
PYTHON_SHA256="3b48dac8fb59f62eaa67ac83c1eb12bda1b7a08406dd286e252c11a66be27f81"

# renovate: datasource=docker depName=quay.io/pypa/manylinux_2_28_x86_64
MANYLINUX_AMD64="quay.io/pypa/manylinux_2_28_x86_64:2026.08.29-1@sha256:41abc24b9e23d18f6aa8dfe5dd0baed8036d158e35bd03c575d9e68bfbe194a9"
# renovate: datasource=docker depName=quay.io/pypa/manylinux_2_28_aarch64
MANYLINUX_ARM64="quay.io/pypa/manylinux_2_28_aarch64:2026.08.29-1@sha256:15ac47b9d4ff96443e73bd2165e26fa412c3044a962e96bc1593bd5798b1dc65"

# nfpm packages the binaries. Pinned image; its digest IS the integrity check.
# renovate: datasource=docker depName=goreleaser/nfpm
NFPM="goreleaser/nfpm:v2.47.0@sha256:a662cb167d7b6d3a83920c83d76b12d02b8ac5dd2c13e5c62c15270b23f6df0c"

# The image the .deb/.rpm parity check unpacks into. Lives here rather than beside the check in
# build-linux-arch.sh because Renovate scans this file, the workflows and packaging/*.Dockerfile —
# not packaging/*.sh. A pin it cannot see is a pin that silently stops being patched while its twin
# in install-smoke.Dockerfile keeps moving.
# renovate: datasource=docker depName=debian-13-current packageName=debian
PARITY_IMAGE="debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132"

# The vendored shared standard (SisyphusMD/project-standard). Renovate watches its tags and opens
# the bump; re-vendoring the files is a separate act, and the invariant test refuses a pin that
# disagrees with STANDARD.lock — so a bumped pin can never be mistaken for re-synced files.
#
# Stored without the leading `v` the tag carries, like the CPython pin above: the shared matchString
# requires a digit first, and a value starting `v` matches nothing at all, silently.
# renovate: datasource=gitea-tags depName=SisyphusMD/project-standard
PROJECT_STANDARD="0.1.21"
