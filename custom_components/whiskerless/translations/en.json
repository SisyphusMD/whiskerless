{
  "config": {
    "flow_title": "{name}",
    "step": {
      "discovery_confirm": {
        "title": "Add Litter-Robot",
        "description": "A Litter-Robot 4 (serial {serial}) was found on your MQTT broker. Give it a name — this becomes the device name and is used to generate its entity IDs.",
        "data": {
          "name": "Name"
        },
        "data_description": {
          "name": "A friendly name for this robot, e.g. \"Upstairs litterbox\". You can rename it later."
        }
      }
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "discovery_only": "Litter-Robots are added automatically when they connect to your MQTT broker. Provision a robot onto your broker (see the documentation) and it will appear here to add.",
      "invalid_discovery_info": "The discovery message did not contain a usable serial number."
    }
  },
  "entity": {
    "sensor": {
      "status": {
        "name": "Status",
        "state": {
          "ready": "Ready",
          "cat_detected": "Cat detected",
          "clean_cycle": "Clean cycle",
          "empty_cycle": "Empty cycle",
          "cat_sensor_timing": "Cat sensor timing",
          "bonnet_removed": "Bonnet removed",
          "powering_up": "Powering up",
          "powering_down": "Powering down",
          "off": "Off",
          "changing_filter": "Changing filter",
          "power_up_cycle": "Power-up cycle"
        }
      },
      "litter_level": {
        "name": "Litter level"
      },
      "waste_drawer_level": {
        "name": "Waste drawer level"
      },
      "pet_weight": {
        "name": "Pet weight"
      },
      "clean_cycle_count": {
        "name": "Clean cycle count"
      },
      "wifi_rssi": {
        "name": "Wi-Fi signal"
      },
      "litter_level_mm": {
        "name": "Litter level distance"
      },
      "last_cat_visit": {
        "name": "Last cat visit"
      },
      "waste_drawer_last_moved": {
        "name": "Waste drawer last moved"
      },
      "last_hopper_dispensed": {
        "name": "Last hopper dispense"
      },
      "last_visit_duration": {
        "name": "Last visit duration"
      },
      "hopper_fill": {
        "name": "Hopper reading"
      },
      "litter_reference": {
        "name": "Litter reference"
      },
      "hopper_level": {
        "name": "Hopper level"
      }
    },
    "binary_sensor": {
      "bonnet_removed": {
        "name": "Bonnet removed"
      },
      "cat_detected": {
        "name": "Cat detected"
      },
      "drawer_full": {
        "name": "Waste drawer full"
      },
      "excess_weight": {
        "name": "Excess weight"
      },
      "globe_motor_fault": {
        "name": "Globe motor fault"
      },
      "hopper_connected": {
        "name": "Hopper"
      },
      "hopper_empty": {
        "name": "Hopper out of litter"
      },
      "panel_sleep_mode": {
        "name": "Panel sleep mode"
      }
    },
    "select": {
      "night_light_mode": {
        "name": "Night light",
        "state": {
          "off": "[%key:common::state::off%]",
          "on": "[%key:common::state::on%]",
          "auto": "Auto"
        }
      }
    },
    "switch": {
      "keypad_lockout": {
        "name": "Control lock"
      },
      "weekday_sleep": {
        "name": "Weekday sleep schedule"
      }
    },
    "number": {
      "clean_cycle_wait": {
        "name": "Clean cycle wait time"
      },
      "night_light_brightness": {
        "name": "Night light brightness"
      },
      "panel_brightness_high": {
        "name": "Panel brightness (bright room)"
      },
      "panel_brightness_low": {
        "name": "Panel brightness (dark room)"
      }
    },
    "time": {
      "panel_sleep_time": {
        "name": "Panel sleep time"
      },
      "panel_wake_time": {
        "name": "Panel wake time"
      }
    },
    "button": {
      "refresh": {
        "name": "Refresh"
      },
      "calibrate_litter_full": {
        "name": "Calibrate full"
      },
      "calibrate_litter_empty": {
        "name": "Calibrate empty"
      },
      "panel_reset": {
        "name": "Reset"
      },
      "start_empty_cycle": {
        "name": "Empty cycle (danger)"
      },
      "power_toggle": {
        "name": "Power toggle (danger)"
      },
      "wifi_toggle": {
        "name": "WiFi toggle (danger)"
      },
      "start_clean_cycle": {
        "name": "Clean cycle"
      }
    }
  },
  "exceptions": {
    "mqtt_unavailable": {
      "message": "The Home Assistant MQTT integration is not available."
    },
    "no_response": {
      "message": "The Litter-Robot did not respond to a state request."
    },
    "command_failed": {
      "message": "Failed to send the command to the Litter-Robot: {error}."
    },
    "litter_reading_unavailable": {
      "message": "No usable litter reading right now — the robot is mid-cycle. Try again once it is idle."
    }
  }
}
